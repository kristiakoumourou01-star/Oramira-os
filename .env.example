# ─────────────────────────────────────────────────────────────────────────────
# Oramira OS — environment variables
# Copy to .env.local for local dev; set the same keys in Vercel for production.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # server-only — NEVER exposed to the client. Used by intake/automation/notification engines.

# App base URL — used to build invite / reset-password / email links.
NEXT_PUBLIC_APP_URL=http://localhost:3000   # production: https://os.oramira.com

# Cron security — Vercel Cron / the Supabase Edge Function send this as
# `Authorization: Bearer <value>`; /api/cron rejects calls without it.
CRON_SECRET=

# ── RECOMMENDED ──────────────────────────────────────────────────────────────

# AI advisory (lead scoring/summaries, Deal Analyzer advisory). If unset, the
# app falls back to deterministic heuristics — everything still works.
ANTHROPIC_API_KEY=

# Email delivery (Resend). If unset, emails are logged to notification_events
# but not actually sent; in-app notifications still work.
RESEND_API_KEY=
RESEND_FROM_ADDRESS="Oramira <notifications@oramira.com>"

# ── OPTIONAL ─────────────────────────────────────────────────────────────────

# Website intake lock-down. If INTAKE_SECRET is set, public contact-form and
# newsletter callers must send it as the `x-intake-key` header.
INTAKE_SECRET=
WEBSITE_ALLOWED_ORIGIN=*        # production: your marketing site origin, e.g. https://oramira.com

# Org defaults (fallback notification recipients)
INTERNAL_ALERTS_EMAIL=
DEFAULT_LEGAL_EMAIL=
DEFAULT_ARCHITECT_EMAIL=

# Supabase project id — only needed locally for `npm run supabase:types`
SUPABASE_PROJECT_ID=
